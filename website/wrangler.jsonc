// Deploys the built website (website/dist) as a Cloudflare Worker with static assets.
// Build first: node website/build.mjs (SITE_URL=https://openartifact.net for canonical links).
{
  "name": "open-artifact-website",
  "account_id": "36b461683fc0ec50dcbc7ec197d44bde",
  "compatibility_date": "2026-11-26",
  "main": "redirect.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "openartifact.net", "custom_domain": true },
    { "pattern": "www.openartifact.net", "custom_domain": true }
  ]
}
