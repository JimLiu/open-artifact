{"text":"<meta name=\"dash-one-writer\">\n<link rel=\"stylesheet\" href=\"app.css\">\n<main class=\"jc\" data-read lang=\"en\">\n  <header class=\"jc-head\" id=\"overview\">\n    <p class=\"jc-eyebrow\">Juniper Coffee</p>\n    <h1 class=\"jc-title\" id=\"title\">Subscriptions</h1>\n    <div class=\"jc-filters\">\n      <label class=\"jc-filter\">Plan\n        <select class=\"dash-select\" data-draw=\"plan-filter\" aria-label=\"Plan\" data-source=\"plans\"></select>\n      </label>\n    </div>\n    <p class=\"jc-lede\" id=\"summary\" data-read-step>Week of <b data-draw=\"lede-week\" data-source=\"totals\" data-field=\"week\">—</b>: <b data-draw=\"lede-subscribers\" data-source=\"kpis\" data-field=\"value\" data-where=\"metric=subscribers\">—</b> active subscribers, <span data-draw=\"lede-direction\" data-source=\"standing\" data-field=\"direction\">—</span> <b data-draw=\"lede-growth\" data-source=\"standing\" data-field=\"gained_by\">—</b> since <span data-draw=\"lede-first\" data-source=\"totals\" data-field=\"week\">—</span><span data-all-plans> and <b data-draw=\"lede-gap\" data-source=\"standing\" data-field=\"gap_by\" data-where=\"plan=All plans\">—</b> <b data-draw=\"lede-side\" data-source=\"standing\" data-field=\"side\" data-where=\"plan=All plans\">—</b> the path to <span data-draw=\"lede-goal\" data-source=\"goals\" data-field=\"subscribers\" data-where=\"week=2026-05-25\">—</span> by <span data-draw=\"lede-goal-day\" data-source=\"goals\" data-field=\"week\">—</span></span>.</p>\n  </header>\n\n  <section class=\"jc-tiles\" id=\"figures\" aria-label=\"Key figures\">\n      <article class=\"jc-card jc-tile\" id=\"tile-subscribers\">\n        <h2>Active subscribers</h2>\n        <p class=\"jc-big\"><span data-draw=\"kpi-subscribers\" data-source=\"kpis\" data-field=\"value\" data-where=\"metric=subscribers\" data-fetchpriority=\"high\">—</span></p>\n        <p class=\"jc-delta\"><span data-draw=\"delta-subscribers\" data-source=\"kpis\" data-field=\"change\" data-where=\"metric=subscribers\">—</span> in 4 weeks</p>\n        <div class=\"jc-spark\" data-draw=\"spark-subscribers\" data-source=\"totals\"></div>\n      </article>\n      <article class=\"jc-card jc-tile\" id=\"tile-mrr\">\n        <h2>Monthly recurring revenue</h2>\n        <p class=\"jc-big\"><span data-draw=\"kpi-mrr\" data-source=\"kpis\" data-field=\"value\" data-where=\"metric=mrr\" data-fetchpriority=\"high\">—</span></p>\n        <p class=\"jc-delta\"><span data-draw=\"delta-mrr\" data-source=\"kpis\" data-field=\"change\" data-where=\"metric=mrr\">—</span> in 4 weeks</p>\n        <div class=\"jc-spark\" data-draw=\"spark-mrr\" data-source=\"totals\"></div>\n      </article>\n      <article class=\"jc-card jc-tile\" id=\"tile-churn\">\n        <h2>Churn, last 4 weeks</h2>\n        <p class=\"jc-big\"><span data-draw=\"kpi-churn\" data-source=\"kpis\" data-field=\"value\" data-where=\"metric=churn\" data-fetchpriority=\"high\">—</span></p>\n        <p class=\"jc-delta\"><span data-draw=\"delta-churn\" data-source=\"kpis\" data-field=\"change\" data-where=\"metric=churn\">—</span> vs prior 4 weeks</p>\n        <div class=\"jc-spark\" data-draw=\"spark-churn\" data-source=\"totals\"></div>\n      </article>\n      <article class=\"jc-card jc-tile\" id=\"tile-order\">\n        <h2>Average order, 4 weeks</h2>\n        <p class=\"jc-big\"><span data-draw=\"kpi-order\" data-source=\"kpis\" data-field=\"value\" data-where=\"metric=order\" data-fetchpriority=\"high\">—</span></p>\n        <p class=\"jc-delta\"><span data-draw=\"delta-order\" data-source=\"kpis\" data-field=\"change\" data-where=\"metric=order\">—</span> vs prior 4 weeks</p>\n        <div class=\"jc-spark\" data-draw=\"spark-order\" data-source=\"totals\"></div>\n      </article>\n  </section>\n  <section class=\"jc-grid\">\n    <figure class=\"jc-card jc-fig\" id=\"subscribers-chart\" data-source=\"totals subscriptions goals\">\n      <figcaption>Subscribers against the spring goal</figcaption>\n      <p class=\"jc-legend\"><span><i></i>Subscribers</span><span data-all-plans><i class=\"jc-goal\"></i>Goal path</span></p>\n      <div class=\"jc-chart\" data-draw=\"trend\"></div>\n      <p class=\"jc-foot\">In the latest week <b data-draw=\"flow-new\" data-source=\"totals\" data-field=\"new\">—</b> people subscribed and <b data-draw=\"flow-cancelled\" data-source=\"totals\" data-field=\"churned\">—</b> cancelled.</p>\n    </figure>\n    <figure class=\"jc-card jc-fig\" id=\"roasts-chart\" data-source=\"roast_week roast_bags roast_catalog\">\n      <figcaption>Bags shipped by roast</figcaption>\n      <p class=\"jc-sub\">Week of <span data-draw=\"roast-week\" data-source=\"roast_week\" data-field=\"week\">—</span></p>\n      <div class=\"jc-bars\" data-draw=\"roasts\"></div>\n      <p class=\"jc-foot\">The tick on each bar is the week before.</p>\n    </figure>\n  </section>\n  <section class=\"jc-grid\">\n    <div class=\"jc-card jc-fig\" id=\"orders\">\n      <h2>Latest orders</h2>\n      <p class=\"jc-sub\">Straight from the shop, newest first</p>\n      <div class=\"jc-scroll\">\n        <table class=\"jc-table\" id=\"orders-table\" data-source=\"orders\" data-row-key=\"order_no\" data-fetchpriority=\"low\">\n          <thead><tr><th data-field=\"order_no\">Order</th><th data-field=\"placed_at\">Placed</th><th data-field=\"plan\">Plan</th><th data-field=\"roast\">Roast</th><th data-field=\"bags\" class=\"jc-num\">Bags</th><th data-field=\"total\" class=\"jc-num\">Total</th><th data-field=\"status\">Status</th></tr></thead>\n          <tbody data-draw=\"orders-rows\"></tbody>\n        </table>\n      </div>\n    </div>\n    <div class=\"jc-card jc-fig\" id=\"plans\">\n      <h2>Plans</h2>\n      <p class=\"jc-sub\">Pick one to filter the page</p>\n      <div class=\"jc-scroll\">\n        <table class=\"jc-table jc-plans\" id=\"plans-table\" data-source=\"plan_mix\" data-row-key=\"plan\">\n          <thead><tr><th data-field=\"plan\">Plan</th><th data-field=\"price\" class=\"jc-num\">A month</th><th data-field=\"subscribers\" class=\"jc-num\">Subscribers</th><th data-field=\"share\" class=\"jc-num\">Share</th></tr></thead>\n          <tbody data-draw=\"plan-rows\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <details class=\"jc-notes\" id=\"definitions\">\n    <summary>How these figures are worked out</summary>\n    <dl>\n      <dt>Active subscribers</dt><dd>Subscriptions that are paid up at the end of the week.</dd>\n      <dt>Monthly recurring revenue</dt><dd>Every active subscription at its plan’s monthly price.</dd>\n      <dt>Churn</dt><dd>Cancellations over four weeks, as a share of the subscribers at the start of those weeks. Lower is better.</dd>\n      <dt>Average order</dt><dd>Revenue over orders for four weeks, add-on bags included.</dd>\n      <dt>Goal path</dt><dd>A straight line from where subscribers stood in the first week to the spring goal. It counts every plan, so it steps aside when one plan is picked.</dd>\n    </dl>\n  </details>\n</main>\n<script src=\"app.js\"></script>\n"}
