              "id": "kr0483lpxzq.5003",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.5004",
                  "text": "Type the code as printed, dashes included. It looks like "
                },
                {
                  "id": "kr0483lpxzq.5061",
                  "text": "FL-7K2Q-9M",
                  "marks": {
                    "code": true
                  }
                },
                {
                  "id": "kr0483lpxzq.5071",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "id": "kr0483lpxzq.5072",
          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.5073",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.5074",
                  "text": "Update the app to version 1.0.2 or later."
                }
              ]
            }
          ]
        },
        {
          "id": "kr0483lpxzq.5115",
          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.5116",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.5117",
                  "text": "Still stuck? Reply with a photo of the code panel and we open the guide by hand."
                }
              ]
            }
          ]
        }
      ]
    },
    {
