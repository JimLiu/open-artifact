      },
      "inline": [
        {
          "id": "kr0483lpxzq.5214",
          "text": "Hi {first name},\n\nThanks for writing in about First Light. {answer}\n\nIf anything else comes up, reply here: launch week has a team on this inbox every day from 9 to 6.\n\n{your name}, Juniper Coffee"
        }
      ]
