          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.5004",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.5005",
                  "text": "Type the code as printed, dashes included. It looks like "
                },
                {
                  "id": "kr0483lpxzq.5062",
                  "text": "FL-7K2Q-9M",
                  "marks": {
                    "code": true
                  }
                },
                {
                  "id": "kr0483lpxzq.5072",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "id": "kr0483lpxzq.5073",
          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.5074",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.5075",
                  "text": "Update the app to version 1.0.2 or later."
                }
              ]
            }
          ]
        },
        {
          "id": "kr0483lpxzq.5116",
          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.5117",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.5118",
                  "text": "Still stuck? Reply with a photo of the code panel and we open the guide by hand."
                }
              ]
            }
          ]
        }
      ]
    },
    {
