          "id": "kr0483lpxzq.429",
          "atom": "mention",
          "attrs": {
            "principal": null,
            "ref": "file/40d54ab0-8945"
          }
        },
        {
          "id": "kr0483lpxzq.430",
          "text": ", and what we tell customers is in "
        },
        {
          "id": "kr0483lpxzq.465",
