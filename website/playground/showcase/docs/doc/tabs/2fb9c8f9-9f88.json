            },
            {
              "id": "kr0483lpxzq.2304",
              "text": "App store review is the one date we do not control.",
              "marks": {
                "bold": true
              }
            },
            {
              "id": "kr0483lpxzq.2355",
              "text": " Submitting by March 24 keeps a three-week buffer. If review slips past April 7, the blend still ships on the 14th and the app follows."
            }
