    {
      "id": "kr0483lpxzq.148",
      "type": "paragraph",
      "inline": [
        {
          "id": "kr0483lpxzq.149",
          "text": "On "
        },
        {
          "id": "kr0483lpxzq.152",
          "text": "Wednesday, April 14",
          "marks": {
            "bold": true
          }
        },
        {
          "id": "kr0483lpxzq.171",
          "text": ", Juniper ships two things on the same morning: "
        },
        {
          "id": "kr0483lpxzq.219",
          "text": "First Light",
          "marks": {
            "bold": true
          }
        },
        {
          "id": "kr0483lpxzq.230",
          "text": ", our spring seasonal blend, and the "
        },
        {
          "id": "kr0483lpxzq.267",
          "text": "Juniper app",
          "marks": {
            "bold": true
          }
        },
        {
          "id": "kr0483lpxzq.278",
          "text": " for iPhone and Android. This brief is the one place for what ships, who owns each piece, and what a good launch looks like."
        }
      ]
    },
    {
      "id": "kr0483lpxzq.402",
      "type": "paragraph",
      "inline": [
        {
          "id": "kr0483lpxzq.403",
          "text": "The day-by-day list is in "
