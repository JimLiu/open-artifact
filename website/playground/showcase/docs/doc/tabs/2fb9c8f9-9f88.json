              ]
            }
          ]
        },
        {
          "id": "kr0483lpxzq.654",
          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.655",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.656",
                  "text": "Keep the promise.",
                  "marks": {
                    "bold": true
                  }
                },
                {
                  "id": "kr0483lpxzq.673",
                  "text": " Three days from the roaster to the doorstep, launch week included."
                }
              ]
            }
          ]
        }
