    },
    {
      "id": "kr0483lpxzq.1965",
      "type": "paragraph",
      "inline": [
        {
          "id": "kr0483lpxzq.1966",
          "text": "The blend gives people a reason to open the box; the app gives them a reason to stay. The code on the bag ties the two together."
        }
      ]
    },
    {
      "id": "kr0483lpxzq.2094",
      "type": "codeBlock",
      "attrs": {
        "language": "mermaid"
      },
      "inline": [
        {
          "id": "kr0483lpxzq.2095",
          "text": "flowchart LR\n    box([First Light in the box]) --> code[Code on the bag]\n    code --> guide[Brew guide in the app]\n    guide --> account[Signed in]\n    account --> stay([Skip, pause or gift in two taps])"
        }
      ]
    },
