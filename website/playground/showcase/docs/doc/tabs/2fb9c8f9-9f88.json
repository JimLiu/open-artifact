              "inline": [
                {
                  "id": "kr0483lpxzq.470",
                  "text": "Grow the base.",
                  "marks": {
                    "bold": true
                  }
                },
                {
                  "id": "kr0483lpxzq.484",
                  "text": " A seasonal blend should bring in subscriptions, not one-off bags."
                }
              ]
            }
          ]
        },
        {
          "id": "kr0483lpxzq.550",
          "type": "listItem",
          "children": [
            {
              "id": "kr0483lpxzq.551",
              "type": "paragraph",
              "inline": [
                {
                  "id": "kr0483lpxzq.552",
                  "text": "Move people into the app.",
                  "marks": {
                    "bold": true
                  }
                },
                {
                  "id": "kr0483lpxzq.577",
                  "text": " Skipping or moving a delivery should take two taps, not an email to support."
