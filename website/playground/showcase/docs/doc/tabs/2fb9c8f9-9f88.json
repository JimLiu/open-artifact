      "inline": [
        {
          "id": "kr0483lpxzq.150",
          "text": "On "
        },
        {
          "id": "kr0483lpxzq.153",
          "text": "Wednesday, April 14",
          "marks": {
            "bold": true
          }
        },
        {
          "id": "kr0483lpxzq.172",
          "text": ", Juniper ships two things on the same morning: "
        },
        {
          "id": "kr0483lpxzq.220",
          "text": "First Light",
          "marks": {
            "bold": true
          }
        },
        {
          "id": "kr0483lpxzq.231",
          "text": ", our spring seasonal blend, and the "
        },
        {
          "id": "kr0483lpxzq.268",
          "text": "Juniper app",
          "marks": {
            "bold": true
          }
        },
        {
          "id": "kr0483lpxzq.279",
          "text": " for iPhone and Android. This brief is the one place for what ships, who owns each piece, and what a good launch looks like."
        }
      ]
    },
