{
  "id": "whiteboard",
  "type": "whiteboard",
  "typeTitle": "Whiteboard",
  "source": "test-artifacts/whiteboard/elements",
  "omit": ["db/elements/e19.json"],
  "agent": {
    "name": "Agent",
    "thinkMs": 2500,
    "responses": [
      {
        "reply": "Done. I added a sticky note next to the shapes that sums up what you asked for.",
        "edits": [
          {
            "kind": "db",
            "writes": [
              {
                "op": "set",
                "path": "elements/agent-note-{{n}}",
                "data": { "type": "note", "x": 1220, "y": -200, "w": 200, "h": 140, "color": "green", "tilt": 1, "text": "Fixed by the agent: \"{{request}}\"", "by": "agent" }
              }
            ],
            "appendOrder": { "path": "board/meta", "field": "order", "value": "agent-note-{{n}}" }
          }
        ]
      },
      {
        "reply": "Added another note and a label for the flow on the left.",
        "edits": [
          {
            "kind": "db",
            "writes": [
              {
                "op": "set",
                "path": "elements/agent-note-{{n}}",
                "data": { "type": "note", "x": 1460, "y": -200, "w": 200, "h": 140, "color": "blue", "tilt": -1, "text": "Second pass: \"{{request}}\"", "by": "agent" }
              }
            ],
            "appendOrder": { "path": "board/meta", "field": "order", "value": "agent-note-{{n}}" }
          }
        ]
      }
    ]
  }
}
