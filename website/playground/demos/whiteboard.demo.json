                  "html": "<title>Quick vote</title>\n<style>\nbody{margin:0;padding:14px 16px;font:14px/1.35 system-ui,sans-serif;color:#1d1b16;background:#f7f2e8}\n#q{margin:0 0 12px;font-weight:600;max-height:57px;overflow:hidden}\n.row{display:flex;gap:8px}\nbutton{flex:1;padding:8px 6px;border:1px solid #20402f;border-radius:999px;background:#fff;color:#20402f;font:inherit;cursor:pointer}\n#yes{background:#20402f;color:#f7f2e8}\nbutton b{margin-left:8px}\n#t{margin:10px 0 0;font-size:12px;color:#5b7f5e}\n</style>\n<p id='q'></p>\n<div class='row'><button type='button' id='yes'>Do it<b id='a'>0</b></button><button type='button' id='no'>Not now<b id='b'>0</b></button></div>\n<p id='t'></p>\n<script>\nvar data = Object.assign({q: 'Do this before launch?', votes: [0, 0]}, boardEmbed.load());\nfunction draw() {\n  var n = data.votes[0] + data.votes[1];\n  document.getElementById('q').textContent = data.q;\n  document.getElementById('a').textContent = data.votes[0];\n  document.getElementById('b').textContent = data.votes[1];\n  document.getElementById('t').textContent = n ? n + (n === 1 ? ' vote' : ' votes') + ' so far' : 'Click to vote: the board keeps the tally.';\n}\nfunction changed() { draw(); boardEmbed.save(data); }\nboardEmbed.onLoad(function (theirs) { if (theirs) { data = theirs; draw(); } });\ndocument.getElementById('yes').addEventListener('click', function () { data.votes[0]++; changed(); });\ndocument.getElementById('no').addEventListener('click', function () { data.votes[1]++; changed(); });\ndraw();\n</script>",
