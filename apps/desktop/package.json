{
  "name": "open-artifact-desktop",
  "private": true,
  "version": "0.16.1",
  "type": "module",
  "description": "Open Artifact Desktop: the Electron app that shows the local library's artifacts in tabs, with no agent.",
  "main": "out/main.mjs",
  "scripts": {
    "setup": "npm install && install-electron",
    "build": "node scripts/build-runtime.ts && node build.ts",
    "start": "node build.ts && electron .",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.ts",
    "package": "npm run build && node scripts/package.ts",
    "package:release": "npm run build && node scripts/package.ts --release",
    "test:release": "node --test test/release.test.ts",
    "test:packaged": "node --test --test-concurrency=1 test/packaged/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "devtools-protocol": "0.0.1754134",
    "electron": "45.2.2",
    "esbuild": "0.25.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
