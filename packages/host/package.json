    "./files": "./src/node/files.ts"
  },
  "dependencies": {
    "@open-artifact/host-plugin": "0.13.0",
    "@open-artifact/protocol": "0.13.0",
    "@open-artifact/runtime": "0.13.0",
    "@open-artifact/server-sdk": "0.13.0",
    "@open-artifact/type-server": "0.13.0"
  },
  "license": "Apache-2.0"
}
