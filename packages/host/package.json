{
  "name": "@open-artifact/host",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "The Open Artifact cloud host: a platform-neutral core (HTTP routing, page tokens, the catalog, authorization) and its Node adapter.",
