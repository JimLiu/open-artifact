    "./db": "./src/frame/db.ts",
    "./comments": "./src/frame/comments.ts"
  },
  "dependencies": {
    "@open-artifact/protocol": "0.13.0"
  },
  "devDependencies": {
    "@open-artifact/editor-kit": "0.13.0",
    "@open-artifact/runtime": "0.13.0",
    "@open-artifact/ui": "0.13.0"
  },
