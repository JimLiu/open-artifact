{
  "name": "pi-open-artifact",
  "version": "0.18.0",
  "description": "Open Artifact in Pi: the Artifact, ArtifactData and ArtifactComments tools, comments on artifact pages waking the Pi session that made them, the open-artifact skill, and /open-artifact <type> to make a new one.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "open-artifact",
    "artifacts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@open-artifact/cli": "0.18.0",
    "@open-artifact/harness-kit": "0.18.0",
    "@open-artifact/protocol": "0.18.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "Apache-2.0"
}
