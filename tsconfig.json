{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test", "plugins/dsh/src", "plugins/dsh/test", "packages/server-sdk/bin", "packages/*/vite.config.ts", "plugins/pi/src", "plugins/pi/test", "plugins/omp/src", "plugins/omp/test", "scripts/*.ts"],
  "exclude": ["packages/sheets-editor"]
}
